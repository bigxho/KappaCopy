<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KappaCopy.App.MainWindow"
        Title="Kappa Copy"
        Width="980" Height="720"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto" Background="#111318">
    <Border Grid.Row="0" Background="#181B22" BorderBrush="#2A2E38" BorderThickness="0,0,0,1" Padding="26,20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="KAPPA COPY" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="Trasferimenti veloci con Robocopy" Foreground="#9AA3B2" FontSize="13" />
        </StackPanel>
        <Border Grid.Column="1" Background="#20242C" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
          <TextBlock x:Name="EngineStatusText" Text="Robocopy" Foreground="#AAB3C2" FontSize="12" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="26" Spacing="18">
        <Border Background="#181B22" CornerRadius="12" BorderBrush="#2A2E38" BorderThickness="1" Padding="20">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <StackPanel>
                <TextBlock Text="SORGENTI" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="SourceSummaryText" Text="Nessun file o cartella selezionato" Foreground="#8F98A8" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="+ File" Click="AddFiles_Click" />
              <Button Grid.Column="2" Classes="secondary" Content="+ Cartella" Click="AddFolder_Click" />
            </Grid>

            <Border Background="#111318" CornerRadius="8" BorderBrush="#292D36" BorderThickness="1" MinHeight="116" MaxHeight="190">
              <Grid>
                <ListBox x:Name="SourcesList" Margin="6" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,5" ColumnSpacing="10">
                        <TextBlock Text="{Binding TypeLabel}" Foreground="#7F8DA3" Width="60" />
                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="#8F98A8" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptySourcesText" Text="Aggiungi file o cartelle da copiare"
                           Foreground="#687181" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <Button Content="Rimuovi selezionato" Classes="secondary" HorizontalAlignment="Left" Click="RemoveSelected_Click" />
              <Button Grid.Column="1" Content="Svuota elenco" Classes="secondary" Click="ClearSources_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="#181B22" CornerRadius="12" BorderBrush="#2A2E38" BorderThickness="1" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="DESTINAZIONE" FontWeight="SemiBold" FontSize="13" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox x:Name="DestinationTextBox" Watermark="Seleziona la cartella di destinazione..." IsReadOnly="True" />
              <Button Grid.Column="1" Content="Sfoglia..." Classes="secondary" Click="PickDestination_Click" />
            </Grid>
          </StackPanel>
        </Border>

		  <Border Background="#181B22"
		  CornerRadius="12"
		  BorderBrush="#2A2E38"
		  BorderThickness="1"
		  Padding="20">

			  <Grid ColumnDefinitions="*,220"
					RowDefinitions="Auto,Auto"
					ColumnSpacing="22"
					RowSpacing="16">

				  <StackPanel Spacing="8">

					  <TextBlock Text="PROFILO COPIA"
								 FontWeight="SemiBold"
								 FontSize="13" />

					  <TextBlock x:Name="ProfileDescriptionText"
								 Text="Bilanciato: 8 thread, retry limitati."
								 Foreground="#8F98A8"
								 FontSize="12"
								 TextWrapping="Wrap" />

				  </StackPanel>

				  <ComboBox x:Name="ProfileComboBox"
							Grid.Column="1"
							SelectedIndex="0"
							SelectionChanged="ProfileComboBox_SelectionChanged">

					  <ComboBoxItem Content="Automatico" />
					  <ComboBoxItem Content="Veloce" />
					  <ComboBoxItem Content="Sicuro" />

				  </ComboBox>

				  <StackPanel Grid.Row="1"
							  Grid.ColumnSpan="2"
							  Orientation="Horizontal"
							  Spacing="10">

					  <CheckBox x:Name="CompletionSoundCheckBox"
								Content="Suono al termine"
								IsChecked="True"
								IsCheckedChanged="CompletionSoundCheckBox_IsCheckedChanged" />

					  <TextBlock Text="Riproduce un avviso quando la copia termina correttamente."
								 Foreground="#7F8898"
								 FontSize="11"
								 VerticalAlignment="Center" />

				  </StackPanel>

			  </Grid>

		  </Border>

        <Border Background="#181B22" CornerRadius="12" BorderBrush="#2A2E38" BorderThickness="1" Padding="20">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="AVANZAMENTO" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="StatusText" Text="Pronto" Foreground="#8F98A8" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
              <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" FontSize="24" FontWeight="Bold" />
            </Grid>

            <ProgressBar x:Name="OverallProgressBar" Minimum="0" Maximum="100" Value="0" Height="9" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Background="#111318" CornerRadius="8" Padding="12">
                <StackPanel>
                  <TextBlock Text="Elementi" Foreground="#7F8898" FontSize="11" />
                  <TextBlock x:Name="ItemsProgressText" Text="0 / 0" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#111318" CornerRadius="8" Padding="12">
                <StackPanel>
                  <TextBlock Text="Dimensione" Foreground="#7F8898" FontSize="11" />
                  <TextBlock x:Name="TotalSizeText" Text="0 B" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#111318" CornerRadius="8" Padding="12">
                <StackPanel>
                  <TextBlock Text="Tempo" Foreground="#7F8898" FontSize="11" />
                  <TextBlock x:Name="ElapsedText" Text="00:00:00" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Expander Header="Log Robocopy" IsExpanded="False">
              <TextBox x:Name="LogTextBox" Height="150" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" />
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#181B22" BorderBrush="#2A2E38" BorderThickness="0,1,0,0" Padding="26,16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
        <TextBlock x:Name="FooterText" Text="Kappa Copy v0.1 • .NET 8 • Avalonia" Foreground="#727B8A" VerticalAlignment="Center" FontSize="12" />
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Classes="secondary" IsEnabled="False" Click="Cancel_Click" />
        <Button x:Name="CopyButton" Grid.Column="2" Content="COPY" Classes="primary" Click="StartCopy_Click" />
		<Button x:Name="CloseButton" Grid.Column="3" Content="Exit" Classes="secondary" IsEnabled="True" Click="Close_Click" />
	  </Grid>
    </Border>
  </Grid>
</Window>
